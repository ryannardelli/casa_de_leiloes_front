{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://casa-de-leiloes-back.onrender.com/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://casa-de-leiloes-back.onrender.com/public/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}